{  
  "compilerOptions": {  
    // Enable latest features  
    "lib": ["ESNext", "DOM"],  
    "target": "ESNext",  
    "module": "ESNext",  // Keep this if using ESM in your source  
    "moduleDetection": "force",  
    "jsx": "react-jsx",  
    "allowJs": true,  

    // Bundler mode  
    "moduleResolution": "bundler",  
    "allowImportingTsExtensions": false,  
    "verbatimModuleSyntax": false,  // Changed to false  
    "esModuleInterop": true,  // Add this setting  
    "noEmit": false,  // Allow emitting of compiled files  

    // Best practices  
    "strict": true,  
    "skipLibCheck": true,  
    "noFallthroughCasesInSwitch": true,  

    // Some stricter flags (disabled by default)  
    "noUnusedLocals": false,  
    "noUnusedParameters": false,  
    "noPropertyAccessFromIndexSignature": false,  

    // Output directories  
    "outDir": "./dist",  // Specify output directory  
    "rootDir": "./src"   // Specify root directory of input files  
  },  
  "include": ["src/**/*.ts"],  
  "exclude": ["node_modules", "dist"]  
}